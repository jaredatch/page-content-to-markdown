{
  "manifest_version": 3,
  "name": "Page Content to Markdown",
  "version": "1.0.1",
  "description": "A browser extension that turns the main content of any web page into clean Markdown for your notes, docs, or AI.",
  "author": "Jared Atchison",
  "developer": {
    "name": "Jared Atchison",
    "url": "https://github.com/jaredatch/page-content-to-markdown"
  },
  "homepage_url": "https://github.com/jaredatch/page-content-to-markdown",
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "page-content-to-markdown@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Content to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-selection-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Toggle element selection mode"
    },
    "quick-extract": {
      "description": "Run default action (Copy/Save) using last-used content type"
    }
  }
}

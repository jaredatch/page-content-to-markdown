# Maintainer-only: secrets for release-automation npm scripts.
#
# Copy this file to .env.local (gitignored) — the npm scripts call
# `op run --env-file=.env.local` so the actual secret values are
# resolved from 1Password at runtime, never stored on disk.
#
# Requires 1Password CLI (https://1password.com/downloads/command-line/)
# with an active session. Adjust the op:// paths if your vault or item
# names differ.

AMO_JWT_ISSUER="op://Private/AMO API Key/issuer"
AMO_JWT_SECRET="op://Private/AMO API Key/secret"
